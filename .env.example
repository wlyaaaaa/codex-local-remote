# Local listener. Keep this on loopback; put Tailscale Funnel in front of it.
CODEX_REMOTE_HOST=127.0.0.1
CODEX_REMOTE_PORT=18790
CODEX_REMOTE_BASE_PATH=/codex-remote

# Optional override. By default the sidecar discovers Codex Desktop's bundled executable.
# CODEX_REMOTE_CODEX_EXE=C:\path\to\codex.exe

# Runtime state is private and must not be committed.
# CODEX_REMOTE_DATA_DIR=C:\Users\you\AppData\Local\CodexLocalRemote
